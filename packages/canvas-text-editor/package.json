{
  "name": "@durgakiran/canvas-text-editor",
  "version": "0.1.4",
  "description": "Lightweight rich-text editor for canvas text shapes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/CanvasTextEditor.d.ts",
      "import": "./dist/CanvasTextEditor.js",
      "default": "./dist/CanvasTextEditor.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./view": {
      "types": "./dist/CanvasTextView.d.ts",
      "import": "./dist/CanvasTextView.js",
      "default": "./dist/CanvasTextView.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durgakiran/beskar.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:package-artifact": "npm run build && tsc -p test/package-artifact-consumer/tsconfig.json && node test/package-artifact-consumer/runtime.mjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish:dry-run": "npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "@tiptap/core": "3.6.6",
    "@tiptap/extension-bold": "3.6.6",
    "@tiptap/extension-bubble-menu": "3.6.6",
    "@tiptap/extension-code": "3.6.6",
    "@tiptap/extension-collaboration": "3.6.6",
    "@tiptap/extension-collaboration-caret": "3.6.6",
    "@tiptap/extension-document": "3.6.6",
    "@tiptap/extension-floating-menu": "3.6.6",
    "@tiptap/extension-hard-break": "3.6.6",
    "@tiptap/extension-highlight": "3.6.6",
    "@tiptap/extension-italic": "3.6.6",
    "@tiptap/extension-link": "3.6.6",
    "@tiptap/extension-list": "3.6.6",
    "@tiptap/extension-paragraph": "3.6.6",
    "@tiptap/extension-text": "3.6.6",
    "@tiptap/extensions": "3.6.6",
    "@tiptap/pm": "3.6.6",
    "@tiptap/react": "3.6.6",
    "@tiptap/y-tiptap": "3.0.0",
    "y-protocols": "1.0.6",
    "lucide-react": "^0.548.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "yjs": "^13.6.0"
  },
  "keywords": [
    "canvas",
    "rich-text",
    "tiptap",
    "collaboration",
    "yjs"
  ],
  "license": "MIT"
}
