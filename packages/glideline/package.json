{
  "name": "@durgakiran/glideline",
  "version": "0.0.9",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durgakiran/beskar.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test:package-artifact": "tsc -p test/package-artifact-consumer/tsconfig.json && node test/package-artifact-consumer/runtime.mjs",
    "prepublishOnly": "npm run build",
    "publish:dry-run": "npm run build && npm pack --dry-run",
    "publish:github": "npm run build && npm publish",
    "test": "vitest run",
    "test:phase3:coverage": "node ../../docker/scripts/produce-phase-3-coverage.mjs glideline",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "dagre": "^0.8.5",
    "jotai": "^2.20.0",
    "perfect-freehand": "^1.2.3",
    "rbush": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/dagre": "^0.7.3",
    "@types/node": "^25.7.0",
    "@types/rbush": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "happy-dom": "^20.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
