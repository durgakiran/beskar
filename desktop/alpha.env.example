# Public desktop build inputs ONLY. Copy to alpha.env and edit.
# Literal KEY=value syntax; no shell commands, expansion, export, or inline comments.
# Never use the backend deployment env file here. No client secret is needed.
ALPHA_VERSION=0.1.0-alpha.3
ALPHA_BUILD=3
ALPHA_API_ORIGIN=https://app.teddox.com
ALPHA_ISSUER_ORIGIN=https://id.teddox.com
# Required: replace with the production NATIVE/public OAuth client ID.
ALPHA_CLIENT_ID=
# Empty means the current Mac's architecture (arm64 or amd64).
ALPHA_ARCH=
