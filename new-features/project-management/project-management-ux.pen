    {
      "type": "text",
      "id": "OJGfm",
      "x": 12024,
      "y": 1916,
      "name": "briefTitle",
      "fill": "$color.text.default",
      "textGrowth": "fixed-width",
      "width": "fill_container(2402)",
      "content": "Cycles UX: feature map and visual rules",
      "lineHeight": 1.15,
      "fontFamily": "Inter",
      "fontSize": 30,
      "fontWeight": "700"
    },
    {
      "type": "text",
      "id": "sCa0r",
      "x": 12024,
      "y": 1969,
      "name": "briefIntro",
      "fill": "$color.text.subtle",
      "textGrowth": "fixed-width",
      "width": "fill_container(2402)",
      "content": "Cycles add a planning layer to project management without turning tickets into a heavy process system. The UI should show overlapping Sprint, Milestone, and Quarter tracks clearly while keeping everyday list, board, and detail views compact.",
      "lineHeight": 1.45,
      "fontFamily": "Inter",
      "fontSize": 14,
      "fontWeight": "normal"
    },
    {
      "type": "frame",
      "id": "t3CxqF",
      "x": 12024,
      "y": 2007,
      "name": "briefGridTop",
      "width": "fill_container(2402)",
      "height": 310,
      "gap": 16,
      "children": [
        {
          "type": "frame",
          "id": "QuBnM",
          "name": "Model card",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "k2zTh",
              "name": "modelTitle",
              "fill": "$color.text.default",
              "content": "Core model",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "qVaRX",
              "name": "modelBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Track: planning lane such as Sprint, Milestone, Quarter\n• Cycle: dated item inside a track, such as Sprint 15 or Q3 FY26\n• Assignment: ticket-to-cycle join record\n• V1 rule: one cycle per ticket per track; multiple tracks per ticket\n• Seed defaults can start with Sprint, Milestone, Quarter",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "qNwFB",
          "name": "Rollout card",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "vfQEU",
              "name": "phasesTitle",
              "fill": "$color.text.default",
              "content": "Rollout shape",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "W8Wccz",
              "name": "phasesBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Phase 1 integrates planning into current views: header summaries, cycle filters, compact chips, grouped Planning fields, and bulk assignment.\n\nPhase 2 adds a Cycles tab with the track timeline, selected-cycle inspector, and cycle management actions.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ubHyd",
          "name": "Visual card",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "yCvaC",
              "name": "visualTitle",
              "fill": "$color.text.default",
              "content": "Visual language",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "o5zPHn",
              "name": "visualBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Neutral surfaces remain dominant\n• Color differentiates track chips and selected bars only\n• Timeline rows use subtle borders and dense labels\n• Normal ticket surfaces show at most 2 planning chips\n• Mobile becomes stacked track sections, not a shrunken timeline",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "A8g1T",
      "x": 12024,
      "y": 2335,
      "name": "briefGridMid",
      "width": "fill_container(2402)",
      "height": 390,
      "gap": 16,
      "children": [
        {
          "type": "frame",
          "id": "DUiXF",
          "name": "Feature inventory",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "uS1hL",
              "name": "featuresTitle",
              "fill": "$color.text.default",
              "content": "Feature inventory",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "XhPcT",
              "name": "featuresBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Project header\n• Current cycle summary by track\n• Unplanned counts by track\n• Create cycle and Manage cycles actions\n\nList / board / my work\n• Cycle, track, and unplanned-track filters\n• Compact Planning chips in rows and cards\n• Bulk set or clear cycle by track\n\nTicket detail / create\n• Grouped Planning section generated from tracks\n• Prefill from selected cycle context or parent ticket",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "PfwI6",
          "name": "Cycles tab anatomy",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "AsUtq",
              "name": "timelineTitle",
              "fill": "$color.text.default",
              "content": "Cycles tab anatomy",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "thbWI",
              "name": "timelineBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "1. Planning toolbar: time scale, track filters, unplanned filter, create cycle\n2. Time axis: week/month markers and Today line\n3. Track rows: Quarter, Milestone, Sprint with bars or date markers\n4. Selected-cycle inspector: goal, state, dates, ticket counts, assigned tickets\n5. Actions: edit, assign tickets, complete, archive",
              "lineHeight": 1.55,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "rK5PZ",
      "x": 12024,
      "y": 2743,
      "name": "briefRules",
      "width": "fill_container(2402)",
      "height": "fill_container(305)",
      "gap": 16,
      "children": [
        {
          "type": "frame",
          "id": "UnzIP",
          "name": "Rules and states card",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "IarTJ",
              "name": "rulesStateTitle",
              "fill": "$color.text.default",
              "content": "Rules and states",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "qQdwi",
              "name": "rulesStateBody",
              "fill": "$color.text.subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Cycle states: planned, active, completed, canceled\n• Sprint and Quarter default to single active\n• Milestone can allow multiple active cycles\n• Completed cycles keep history visible\n• Sprint completion requires carryover or clear decision for open tickets\n• Archived or canceled cycles cannot receive new assignments",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "DBniz",
          "name": "Agent and API card",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "cornerRadius": 8,
          "stroke": "$color.border.default",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
