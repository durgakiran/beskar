
NEXT_PUBLIC_IMAGE_SERVER_URL=http://localhost:8082
# Optional API base including /api/v1. If unset, attachments use ${NEXT_PUBLIC_IMAGE_SERVER_URL}/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8082/api/v1
NEXT_PUBLIC_USER_SERVER_URL=http://localhost:8084
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=
STORAGE_S3_BASE_URL=

# Email notification engine
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_WORKER_ENABLED=true
EMAIL_ADMIN_ENABLED=true
EMAIL_ADMIN_TOKEN=local-email-admin-token
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Beskar
EMAIL_APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_WORKER_POLL_INTERVAL_SECONDS=10
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=10
EMAIL_RETRY_INITIAL_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=21600

# Quota system
QUOTA_SYSTEM_ENABLED=true
QUOTA_STORAGE_BLOCKING_ENABLED=true
QUOTA_COLLABORATOR_BLOCKING_ENABLED=true
QUOTA_MONITOR_ONLY=false
QUOTA_RECONCILIATION_ENABLED=false
QUOTA_RECONCILIATION_INTERVAL=6h
QUOTA_ADMIN_ENABLED=false
QUOTA_ADMIN_TOKEN=

# Asset cleanup
ASSET_CLEANUP_ENABLED=false
ASSET_CLEANUP_DRY_RUN=true
ASSET_CLEANUP_PURGE_ENABLED=false
ASSET_CLEANUP_ADMIN_ENABLED=false
ASSET_CLEANUP_ADMIN_TOKEN=
ASSET_CLEANUP_MARK_INTERVAL=1h
ASSET_CLEANUP_PURGE_INTERVAL=6h
ASSET_CLEANUP_ORPHAN_GRACE=24h
ASSET_CLEANUP_PURGE_GRACE=168h
ASSET_CLEANUP_MAX_MARKS_PER_RUN=100
ASSET_CLEANUP_MAX_PURGES_PER_RUN=50

# Document version cleanup
DOCUMENT_VERSION_CLEANUP_ENABLED=false
DOCUMENT_VERSION_CLEANUP_DRY_RUN=true
DOCUMENT_VERSION_CLEANUP_ADMIN_ENABLED=false
DOCUMENT_VERSION_CLEANUP_ADMIN_TOKEN=
DOCUMENT_VERSION_DEFAULT_RETENTION_DAYS=7
DOCUMENT_VERSION_CLEANUP_BATCH_SIZE=500
DOCUMENT_VERSION_CLEANUP_MAX_DOCS_PER_RUN=500
DOCUMENT_VERSION_CLEANUP_INTERVAL=24h

ZITADEL_REGISTRATION_ORG_ID=

# Confidential browser OAuth client, registered for client_secret_basic in Zitadel.
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
# Independent random 32-byte cookie/state/PKCE encryption key.
KEY=

# Required for browser access-token introspection. Audience is the Zitadel project ID.
# Introspection uses the same ZITADEL_CLIENT_ID and ZITADEL_CLIENT_SECRET as login.
ZITADEL_API_AUDIENCE=

# Shared browser sessions: all replicas must use the same Redis and KEY/session key.
BROWSER_SESSION_IDLE_TIMEOUT=30m
BROWSER_SESSION_ABSOLUTE_TIMEOUT=8h
# REDIS_ADDR accepts redis:// or rediss:// and takes precedence over host settings.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Required: comma-separated OAuth client IDs allowed to call APIs with bearer access tokens.
# Include the desktop client ID; no wildcard or implicit browser-client allowance.
ZITADEL_BEARER_CLIENT_IDS=

# Notification v2 occurrence scheduler (does not send notifications).
# Apply notifications_v2 migrations before enabling. Durations use Go syntax.
NOTIFICATION_V2_SCHEDULER_ENABLED=false
NOTIFICATION_V2_SCHEDULER_POLL_INTERVAL=1s
NOTIFICATION_V2_SCHEDULER_BATCH_SIZE=100
NOTIFICATION_V2_SCHEDULER_MISFIRE_GRACE=60s
NOTIFICATION_V2_SCHEDULER_TRANSACTION_TIMEOUT=10s

# Notification v2 audience expansion (registered users; no delivery sending).
NOTIFICATION_V2_EXPANDER_ENABLED=false
NOTIFICATION_V2_EXPANDER_POLL_INTERVAL=2s
NOTIFICATION_V2_EXPANDER_BATCH_SIZE=25
NOTIFICATION_V2_EXPANDER_TRANSACTION_TIMEOUT=30s
NOTIFICATION_V2_EXPANDER_LEASE_DURATION=60s
NOTIFICATION_V2_EXPANDER_MAX_ATTEMPTS=5
NOTIFICATION_V2_EXPANDER_RETRY_INITIAL=30s
NOTIFICATION_V2_EXPANDER_RETRY_MAX=15m
NOTIFICATION_V2_EXPANDER_MAX_RECIPIENTS=10000
# Stable base64 secret, at least 32 decoded bytes; required when enabled.
NOTIFICATION_V2_DESTINATION_HASH_KEY=

# Notification v2 delivery loops. SMTP uses the existing EMAIL_*/SMTP_* settings.
# Both loops require the shared NOTIFICATION_V2_DESTINATION_HASH_KEY above.
NOTIFICATION_V2_DELIVERY_EMAIL_ENABLED=false
NOTIFICATION_V2_DELIVERY_IN_APP_ENABLED=false
NOTIFICATION_V2_DELIVERY_POLL_INTERVAL=1s
NOTIFICATION_V2_DELIVERY_BATCH_SIZE=25
NOTIFICATION_V2_DELIVERY_TRANSACTION_TIMEOUT=10s
NOTIFICATION_V2_DELIVERY_SEND_TIMEOUT=15s
NOTIFICATION_V2_DELIVERY_LEASE_DURATION=60s
# UUID of the v2 smtp provider row bound to the existing account.
NOTIFICATION_V2_SMTP_PROVIDER_ID=

# Dedicated recovery of abandoned v2 expansion and delivery leases.
# Enable alongside the expander/delivery workers for crash recovery.
NOTIFICATION_V2_RECOVERY_ENABLED=false
NOTIFICATION_V2_RECOVERY_POLL_INTERVAL=15s
NOTIFICATION_V2_RECOVERY_TRANSACTION_TIMEOUT=10s
NOTIFICATION_V2_RECOVERY_BATCH_SIZE=100

# Published-document search: apply source and target migrations before enabling.
SEARCH_SYNC_CAPTURE_ENABLED=false
SEARCH_SYNC_WORKER_ENABLED=false
PG_SEARCH_HOST=localhost
PG_SEARCH_PORT=5433
PG_SEARCH_DB=search
PG_SEARCH_USER=search_writer
PG_SEARCH_PASSWORD=
PG_SEARCH_SSLMODE=prefer
SEARCH_SYNC_POLL_INTERVAL=1s
SEARCH_SYNC_TRANSACTION_TIMEOUT=30s
SEARCH_SYNC_BATCH_SIZE=25
SEARCH_SYNC_MAX_ATTEMPTS=10
SEARCH_SYNC_RETRY_INITIAL=1s
SEARCH_SYNC_RETRY_MAX=5m
