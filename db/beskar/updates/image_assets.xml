<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="1-create-image-asset-table" author="Kiran Kumar">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 'image_asset' AND table_schema = 'core';
            </sqlCheck>
        </preConditions>
        <comment>Create image_asset table for page-scoped document images</comment>
        <createTable tableName="image_asset" schemaName="core">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="page_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="public_name" type="TEXT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_image_asset_public_name"/>
            </column>
            <column name="storage_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="original_file_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="file_size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="width" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="height" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <rollback>
            <dropTable tableName="image_asset" schemaName="core"/>
        </rollback>
    </changeSet>

    <changeSet id="2-image-asset-page-fkey" author="Kiran Kumar">
        <comment>Foreign key: image_asset.page_id → core.page.id (cascade on page delete)</comment>
        <addForeignKeyConstraint
            baseTableName="image_asset" baseTableSchemaName="core" baseColumnNames="page_id"
            constraintName="image_asset_page_id_fkey"
            referencedTableName="page" referencedTableSchemaName="core" referencedColumnNames="id"
            deleteCascade="true"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="image_asset" baseTableSchemaName="core" constraintName="image_asset_page_id_fkey"/>
        </rollback>
    </changeSet>

    <changeSet id="3-image-asset-page-id-index" author="Kiran Kumar">
        <comment>Index on page_id for efficient per-page image asset queries</comment>
        <createIndex tableName="image_asset" schemaName="core" indexName="idx_image_asset_page_id">
            <column name="page_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="image_asset" schemaName="core" indexName="idx_image_asset_page_id"/>
        </rollback>
    </changeSet>

    <changeSet id="4-grant-image-asset-privileges" author="Kiran Kumar">
        <comment>Grant SELECT, INSERT, UPDATE, DELETE on image_asset table to app user</comment>
        <sql>
            GRANT SELECT, INSERT, UPDATE, DELETE ON core.image_asset TO ${app_user};
        </sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
