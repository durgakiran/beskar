<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="project-management-1-create-project-schema" author="OpenAI Codex">
        <comment>Create project schema for project-management feature</comment>
        <sql>
            <![CDATA[
                CREATE SCHEMA IF NOT EXISTS project;
                GRANT USAGE ON SCHEMA project TO ${app_user};
                ALTER DEFAULT PRIVILEGES FOR USER beskar_admin IN SCHEMA project GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO ${app_user};
                ALTER DEFAULT PRIVILEGES FOR USER beskar_admin IN SCHEMA project GRANT ALL ON SEQUENCES TO ${app_user};
            ]]>
        </sql>
        <rollback>
            <sql>DROP SCHEMA IF EXISTS project CASCADE;</sql>
        </rollback>
    </changeSet>

    <changeSet id="project-management-2-extend-page-type-check" author="OpenAI Codex">
        <comment>Allow project pages in core.page.type</comment>
        <sql>
            <![CDATA[
                ALTER TABLE core.page DROP CONSTRAINT IF EXISTS chk_page_type;
                ALTER TABLE core.page
                    ADD CONSTRAINT chk_page_type
                    CHECK (type IN ('document', 'whiteboard', 'project'));
            ]]>
        </sql>
        <rollback>
            <sql>
                <![CDATA[
                    ALTER TABLE core.page DROP CONSTRAINT IF EXISTS chk_page_type;
                    ALTER TABLE core.page
                        ADD CONSTRAINT chk_page_type
                        CHECK (type IN ('document', 'whiteboard'));
                ]]>
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="project-management-3-create-projects-table" author="OpenAI Codex">
        <comment>Create project.projects table</comment>
        <createTable tableName="projects" schemaName="project">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="page_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="space_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="default_view" type="TEXT" defaultValue="list">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="archived_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="projects" baseTableSchemaName="project" baseColumnNames="page_id"
            constraintName="fk_project_projects_page"
            referencedTableName="page" referencedTableSchemaName="core" referencedColumnNames="id"
            deleteCascade="true"/>
        <addForeignKeyConstraint
            baseTableName="projects" baseTableSchemaName="project" baseColumnNames="space_id"
            constraintName="fk_project_projects_space"
            referencedTableName="space" referencedTableSchemaName="core" referencedColumnNames="id"
            deleteCascade="true"/>
        <addUniqueConstraint tableName="projects" schemaName="project" columnNames="space_id,key" constraintName="uq_project_projects_space_key"/>
        <sql>
            <![CDATA[
                ALTER TABLE project.projects
                    ADD CONSTRAINT chk_project_default_view
                    CHECK (default_view IN ('list', 'board', 'my_work'));
            ]]>
        </sql>
        <createIndex tableName="projects" schemaName="project" indexName="idx_project_projects_space_id">
            <column name="space_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="projects" schemaName="project"/>
        </rollback>
    </changeSet>

    <changeSet id="project-management-4-create-tickets-table" author="OpenAI Codex">
        <validCheckSum>ANY</validCheckSum>
        <comment>Create project.tickets table</comment>
        <createTable tableName="tickets" schemaName="project">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_no" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="identifier" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT" defaultValue="task">
                <constraints nullable="false"/>
            </column>
            <column name="parent_ticket_id" type="UUID"/>
            <column name="root_ticket_id" type="UUID"/>
            <column name="depth" type="SMALLINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TEXT" defaultValue="todo">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="TEXT" defaultValue="medium">
                <constraints nullable="false"/>
            </column>
            <column name="assignee_user_id" type="UUID"/>
            <column name="assignee_name" type="TEXT"/>
            <column name="reporter_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reporter_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="label_names" type="TEXT[]" defaultValueComputed="'{}'::text[]">
                <constraints nullable="false"/>
            </column>
            <column name="due_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="rank" type="TEXT"/>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="archived_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="tickets" baseTableSchemaName="project" baseColumnNames="project_id"
            constraintName="fk_project_tickets_project"
            referencedTableName="projects" referencedTableSchemaName="project" referencedColumnNames="id"
            deleteCascade="true"/>
        <addForeignKeyConstraint
            baseTableName="tickets" baseTableSchemaName="project" baseColumnNames="parent_ticket_id"
            constraintName="fk_project_tickets_parent"
            referencedTableName="tickets" referencedTableSchemaName="project" referencedColumnNames="id"
            onDelete="SET NULL"/>
        <addForeignKeyConstraint
            baseTableName="tickets" baseTableSchemaName="project" baseColumnNames="root_ticket_id"
            constraintName="fk_project_tickets_root"
            referencedTableName="tickets" referencedTableSchemaName="project" referencedColumnNames="id"
            onDelete="SET NULL"/>
        <addUniqueConstraint tableName="tickets" schemaName="project" columnNames="project_id,sequence_no" constraintName="uq_project_tickets_project_sequence"/>
        <addUniqueConstraint tableName="tickets" schemaName="project" columnNames="project_id,identifier" constraintName="uq_project_tickets_project_identifier"/>
        <sql>
            <![CDATA[
                ALTER TABLE project.tickets
                    ADD CONSTRAINT chk_project_ticket_type
                    CHECK (type IN ('epic', 'story', 'task', 'subtask', 'bug'));

                ALTER TABLE project.tickets
                    ADD CONSTRAINT chk_project_ticket_status
                    CHECK (status IN ('backlog', 'todo', 'in_progress', 'in_review', 'done', 'canceled'));

                ALTER TABLE project.tickets
                    ADD CONSTRAINT chk_project_ticket_priority
                    CHECK (priority IN ('none', 'low', 'medium', 'high', 'urgent'));
            ]]>
        </sql>
        <createIndex tableName="tickets" schemaName="project" indexName="idx_project_tickets_project_status_updated">
            <column name="project_id"/>
            <column name="status"/>
            <column name="updated_at"/>
        </createIndex>
        <createIndex tableName="tickets" schemaName="project" indexName="idx_project_tickets_project_parent">
            <column name="project_id"/>
            <column name="parent_ticket_id"/>
        </createIndex>
        <createIndex tableName="tickets" schemaName="project" indexName="idx_project_tickets_project_root">
            <column name="project_id"/>
            <column name="root_ticket_id"/>
        </createIndex>
        <createIndex tableName="tickets" schemaName="project" indexName="idx_project_tickets_project_assignee">
            <column name="project_id"/>
            <column name="assignee_user_id"/>
        </createIndex>
        <sql>
            <![CDATA[
                GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA project TO ${app_user};
            ]]>
        </sql>
        <rollback>
            <dropTable tableName="tickets" schemaName="project"/>
        </rollback>
    </changeSet>

