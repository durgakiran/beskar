<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">


    <changeSet id="1-create-notifications-schema" author="Kiran Kumar">
        <comment>Create notification schema</comment>
        <sql>
                <![CDATA[ 
                    CREATE SCHEMA IF NOT EXISTS notifications;
                ]]>
            </sql>
        <rollback></rollback>
    </changeSet>

    <changeSet id="2-grant-usage-to-app-user-notifications-schema" author="Kiran Kumar">
        <sql>
            ALTER DEFAULT PRIVILEGES FOR USER beskar_admin IN SCHEMA notifications GRANT SELECT, INSERT, UPDATE, DELETE  ON TABLES TO ${app_user};
            ALTER DEFAULT PRIVILEGES FOR USER beskar_admin IN SCHEMA notifications GRANT ALL ON SEQUENCES TO ${app_user};
        </sql>
        <rollback />
    </changeSet>

    <changeSet id="3-create-invites-table" author="Kiran Kumar">
        <preConditions>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 'invites';
            </sqlCheck>
        </preConditions>
        <comment>Create invites table</comment>
        <createTable tableName="invites" schemaName="notifications">
            <column name="sender_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(35)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="entity" type="varchar(35)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4-grant-usage-on-schema-notifications" author="Kiran Kumar">
        <sql>
            GRANT USAGE ON schema notifications TO ${app_user};
        </sql>
        <rollback />
    </changeSet>

    <changeSet id="5-remove-not-null-constraint" author="Kiran Kumar">
        <dropNotNullConstraint tableName="invites" schemaName="notifications" columnName="status" />
    </changeSet>

    <changeSet id="6-remove-not-null-constriant-user-id" author="Kiran Kumar">
        <dropNotNullConstraint tableName="invites" schemaName="notifications" columnName="user_id" />
    </changeSet>

    <changeSet id="7-add-email-id-column" author="kiran kumar">
        <addColumn tableName="invites" schemaName="notifications" >
            <column name="email_id" type="text">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="8-add-role-column" author="kiran kumar">
        <addColumn tableName="invites" schemaName="notifications" >
            <column name="role" type="varchar(30)" />
        </addColumn>
    </changeSet>

    <changeSet id="9-add-invite-timestamps" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="notifications" tableName="invites" columnName="created_at"/>
            </not>
        </preConditions>
        <addColumn tableName="invites" schemaName="notifications">
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="invites" schemaName="notifications" columnName="created_at"/>
            <dropColumn tableName="invites" schemaName="notifications" columnName="updated_at"/>
        </rollback>
    </changeSet>

    <changeSet id="10-add-invite-indexes" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="invites" indexName="idx_invites_pending_lookup"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX idx_invites_pending_lookup
                ON notifications.invites(entity, entity_id, email_id)
                WHERE status IS NULL;
            CREATE INDEX idx_invites_space_pending_created_at
                ON notifications.invites(entity_id, created_at DESC)
                WHERE status IS NULL;
        </sql>
        <rollback>
            <sql>
                DROP INDEX IF EXISTS notifications.idx_invites_pending_lookup;
                DROP INDEX IF EXISTS notifications.idx_invites_space_pending_created_at;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="11-create-notification-events-table" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="notifications" tableName="notification_events"/>
            </not>
        </preConditions>
        <createTable tableName="notification_events" schemaName="notifications">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_key" type="TEXT">
                <constraints nullable="false" unique="true" uniqueConstraintName="notification_events_event_key_key"/>
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="actor_user_id" type="UUID"/>
            <column name="target_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="space_id" type="UUID"/>
            <column name="page_id" type="BIGINT"/>
            <column name="data" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="notification_events" schemaName="notifications"/>
        </rollback>
    </changeSet>

    <changeSet id="12-create-in-app-notifications-table" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="notifications" tableName="in_app_notifications"/>
            </not>
        </preConditions>
        <createTable tableName="in_app_notifications" schemaName="notifications">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false" foreignKeyName="in_app_notifications_event_id_fkey"
                    references="notifications.notification_events(id)" deleteCascade="true"/>
            </column>
            <column name="recipient_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="TEXT"/>
            <column name="target_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="space_id" type="UUID"/>
            <column name="page_id" type="BIGINT"/>
            <column name="action_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="actions" type="JSONB" defaultValueComputed="'[]'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="data" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="dismissed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="resolved_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="in_app_notifications" schemaName="notifications"/>
        </rollback>
    </changeSet>

    <changeSet id="13-add-in-app-notifications-event-recipient-unique" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists schemaName="notifications" tableName="in_app_notifications" constraintName="in_app_notifications_event_recipient_key"/>
            </not>
        </preConditions>
        <addUniqueConstraint schemaName="notifications" tableName="in_app_notifications"
            columnNames="event_id, recipient_user_id" constraintName="in_app_notifications_event_recipient_key"/>
        <rollback>
            <dropUniqueConstraint schemaName="notifications" tableName="in_app_notifications"
                constraintName="in_app_notifications_event_recipient_key"/>
        </rollback>
    </changeSet>

    <changeSet id="14-create-in-app-preferences-table" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="notifications" tableName="in_app_preferences"/>
            </not>
        </preConditions>
        <createTable tableName="in_app_preferences" schemaName="notifications">
            <column name="recipient_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="in_app_preferences" schemaName="notifications"/>
        </rollback>
    </changeSet>

    <changeSet id="15-add-in-app-preferences-primary-key" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists schemaName="notifications" tableName="in_app_preferences" primaryKeyName="in_app_preferences_pkey"/>
            </not>
        </preConditions>
        <addPrimaryKey schemaName="notifications" tableName="in_app_preferences"
            columnNames="recipient_user_id, category" constraintName="in_app_preferences_pkey"/>
        <rollback>
            <dropPrimaryKey schemaName="notifications" tableName="in_app_preferences"
                constraintName="in_app_preferences_pkey"/>
        </rollback>
    </changeSet>

    <changeSet id="16-create-in-app-notifications-user-created-index" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_created"/>
            </not>
        </preConditions>
        <createIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_created">
            <column name="recipient_user_id"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_created"/>
        </rollback>
    </changeSet>

    <changeSet id="17-create-in-app-notifications-user-unread-index" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_unread"/>
            </not>
        </preConditions>
        <createIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_unread">
            <column name="recipient_user_id"/>
            <column name="read_at"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_unread"/>
        </rollback>
    </changeSet>

    <changeSet id="18-create-in-app-notifications-user-action-required-index" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_action_required"/>
            </not>
        </preConditions>
        <createIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_action_required">
            <column name="recipient_user_id"/>
            <column name="action_required"/>
            <column name="resolved_at"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_user_action_required"/>
        </rollback>
    </changeSet>

    <changeSet id="19-create-in-app-notifications-space-created-index" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_space_created"/>
            </not>
        </preConditions>
        <createIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_space_created">
            <column name="space_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_space_created"/>
        </rollback>
    </changeSet>

    <changeSet id="20-create-in-app-notifications-page-created-index" author="OpenAI">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_page_created"/>
            </not>
        </preConditions>
        <createIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_page_created">
            <column name="page_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="notifications" tableName="in_app_notifications" indexName="idx_in_app_notifications_page_created"/>
        </rollback>
    </changeSet>

    <changeSet id="21-grant-notification-events-privileges" author="OpenAI">
        <sql>
            GRANT SELECT, INSERT, UPDATE, DELETE ON notifications.notification_events TO ${app_user};
        </sql>
        <rollback>
            <sql>
                REVOKE SELECT, INSERT, UPDATE, DELETE ON notifications.notification_events FROM ${app_user};
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="22-grant-in-app-notifications-privileges" author="OpenAI">
        <sql>
            GRANT SELECT, INSERT, UPDATE, DELETE ON notifications.in_app_notifications TO ${app_user};
        </sql>
        <rollback>
            <sql>
                REVOKE SELECT, INSERT, UPDATE, DELETE ON notifications.in_app_notifications FROM ${app_user};
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="23-grant-in-app-preferences-privileges" author="OpenAI">
        <sql>
            GRANT SELECT, INSERT, UPDATE, DELETE ON notifications.in_app_preferences TO ${app_user};
        </sql>
        <rollback>
            <sql>
                REVOKE SELECT, INSERT, UPDATE, DELETE ON notifications.in_app_preferences FROM ${app_user};
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
