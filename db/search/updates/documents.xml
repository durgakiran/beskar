<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="search-documents-table-v1" author="Kiran Kumar" dbms="postgresql">
        <createTable schemaName="public" tableName="documents">
            <column name="space_id" type="UUID"><constraints nullable="false"/></column>
            <column name="created_by" type="UUID"><constraints nullable="false"/></column>
            <column name="page_id" type="BIGINT"><constraints primaryKey="true" primaryKeyName="documents_pkey" nullable="false"/></column>
            <column name="doc_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="title" type="TEXT"><constraints nullable="false"/></column>
            <column name="body_text" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable schemaName="public" tableName="documents"/></rollback>
    </changeSet>

    <changeSet id="search-documents-search-index-v1" author="Kiran Kumar" dbms="postgresql">
        <sql>
            CREATE INDEX documents_search_idx ON public.documents USING paradedb
                (page_id,space_id,created_by,doc_id,title,body_text,created_at,updated_at);
        </sql>
        <rollback><dropIndex schemaName="public" tableName="documents" indexName="documents_search_idx"/></rollback>
    </changeSet>

    <changeSet id="search-documents-space-updated-index-v1" author="Kiran Kumar" dbms="postgresql">
        <createIndex schemaName="public" tableName="documents" indexName="documents_space_updated_idx">
            <column name="space_id"/>
            <column name="updated_at" descending="true"/>
            <column name="page_id"/>
        </createIndex>
        <rollback><dropIndex schemaName="public" tableName="documents" indexName="documents_space_updated_idx"/></rollback>
    </changeSet>

    <changeSet id="search-writer-schema-usage-v1" author="Kiran Kumar" dbms="postgresql">
        <sql>GRANT USAGE ON SCHEMA public TO "${search_writer}";</sql>
        <rollback><sql>REVOKE USAGE ON SCHEMA public FROM "${search_writer}";</sql></rollback>
    </changeSet>

    <changeSet id="search-documents-writer-grants-v1" author="Kiran Kumar" dbms="postgresql">
        <sql>GRANT SELECT, INSERT, UPDATE, DELETE ON public.documents TO ${search_writer};</sql>
        <rollback><sql>REVOKE SELECT, INSERT, UPDATE, DELETE ON public.documents FROM ${search_writer};</sql></rollback>
    </changeSet>
</databaseChangeLog>
