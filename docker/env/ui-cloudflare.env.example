# Copy to docker/env/ui-cloudflare.env (ignored by Git).
# Public URLs are compiled into the UI. Use the same values as the Docker UI.
UI_PUBLIC_BASE_URL=https://app.example.com

# Optional overrides; blank values use UI_PUBLIC_BASE_URL + /api/v1 or /ws.
NEXT_PUBLIC_USER_SERVER_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_IMAGE_SERVER_URL=
NEXT_PUBLIC_SIGNALING_URL=
NEXT_PUBLIC_HASURA_PROJECT_ENDPOINT=
NEXT_PUBLIC_PAGE_EVENTS_SSE=
NEXT_PUBLIC_PAGE_EVENTS_TRANSPORT_LOG=
NEXT_PUBLIC_EDITOR_PRESENCE=

# Keep false to use published packages, as in the normal production UI build.
# When true, build the four local package dist directories before running.
UI_USE_LOCAL_PACKAGES_DIST=false

# Use a dedicated Worker while app-domain routing is being designed.
CLOUDFLARE_WORKER_NAME=beskar-ui-preview
# Run npx --yes wrangler@4.155.0 login, then whoami to find the account ID.
CLOUDFLARE_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID:-}

# Wrangler uses your saved local login; no Cloudflare API token is required.
# Prefer exporting the package credential instead of storing it here.
# NPM_TOKEN needs read access to the private @durgakiran GitHub packages.
# export NPM_TOKEN=...
