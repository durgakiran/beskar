{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@http":           ["./app/core/http/index.ts"],
      "@http/hooks":     ["./app/core/http/hooks/index.ts"],
      "@editor":         ["./app/core/editor/index.ts"],
      "@editor/*":       ["./app/core/editor/*"],
      "@components/*":   ["./app/components/*"],
      "@queries/space":  ["./app/core/queries/space/index.ts"],
      "@/lib/utils":     ["./app/lib/utils/index.ts"]
    }
  },
  "include": ["src", "app", "index.html", "vite-env.d.ts"]
}
